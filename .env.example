# ==============================================================================
# SỔ THU CHI - CẤU HÌNH MÔI TRƯỜNG & KHÓA ĐỒNG BỘ ĐÁM MÂY
# ==============================================================================
# Hướng dẫn:
# 1. Điền các thông tin của bạn vào các dòng bên dưới.
# 2. File này (.env) đã được tự động thêm vào .gitignore để bảo mật, không bị đẩy lên GitHub.
# 3. Ứng dụng sẽ tự động tải các giá trị này làm mặc định khi khởi chạy!
# ==============================================================================

# --- MÁY CHỦ RIÊNG ĐỒNG BỘ (SELF-HOSTED / DOCKER SYNC SERVER) ---
# Địa chỉ máy chủ riêng của bạn (nếu chạy qua Docker hoặc VPS/Server riêng)
# Ví dụ: http://localhost:8081 hoặc https://sync.domain-cua-ban.com
SYNC_SERVER_URL=

# Múi giờ của container Docker (ảnh hưởng đến log server)
# Mặc định: Asia/Ho_Chi_Minh (UTC+7). Người dùng nước ngoài đổi thành múi giờ phù hợp.
# Ví dụ: Europe/Paris | America/New_York | Asia/Tokyo | UTC
# Danh sách đầy đủ: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Asia/Ho_Chi_Minh

# Khóa bí mật bảo vệ JWT Session của Server (cho docker-compose hoặc server.js)
JWT_SECRET=sothuchi_super_secure_vault_secret_key_change_me_12345

# --- EMAIL QUẢN TRỊ VIÊN MÁY CHỦ SAO LƯU (ADMIN DASHBOARD /admin) ---
# Email Google có quyền truy cập trang quản trị máy chủ (/admin)
# Dùng để kiểm tra người dùng, dữ liệu rác lúc test hay dữ liệu cũ bị lãng quên
# Ngăn cách bằng dấu phẩy nếu có nhiều email quản trị
ADMIN_EMAIL=


# --- GOOGLE DRIVE OAUTH SYNC ---
# Client ID Google lấy từ Google Cloud Console (loại Web Application)
# Ví dụ: 123456789-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# API Key Google Cloud dùng cho Google Picker (bắt buộc bật Google Picker API & Google Drive API)
# Ví dụ: AIzaSy...
GOOGLE_API_KEY=

# Nơi lưu trữ trên Google Drive: 'appDataFolder' (Thư mục ẩn an toàn) hoặc 'customFolder' (Thư mục Sổ Thu Chi)
GOOGLE_STORAGE_LOCATION=appDataFolder

# Tên thư mục nếu chọn customFolder
GOOGLE_CUSTOM_FOLDER_NAME=Sổ Thu Chi

# Quyền hạn Google Drive OAuth Scope:
# - false (Mặc định): Sử dụng scope 'drive.file' (an toàn tối đa, chỉ truy cập tệp do ứng dụng tạo hoặc chọn qua Picker)
# - true: Sử dụng scope 'drive' (toàn quyền, tự động đọc và đồng bộ mọi tệp sổ/ví được chia sẻ qua email không cần mở Picker)
GOOGLE_DRIVE_FULL_ACCESS=false


# --- CLOUDFLARE WORKER TOKEN BRIDGE (Gia hạn ngầm vĩnh viễn cho iPhone / iOS) ---
# Đường dẫn Cloudflare Worker của bạn (ví dụ: https://my-token-bridge.workers.dev)
GOOGLE_WORKER_URL=

# Client Secret của Google (nếu chưa lưu biến GOOGLE_CLIENT_SECRET trên Cloudflare Worker)
GOOGLE_CLIENT_SECRET=


# --- DROPBOX PKCE SYNC (Chuẩn hiện đại không cần Server, refresh vĩnh viễn) ---
# App Key của Dropbox lấy từ https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=


# --- TỰ ĐỘNG ĐỒNG BỘ ---
# Tự động đồng bộ sau mỗi lần thêm/sửa/xóa giao dịch (true / false)
AUTO_SYNC_ENABLED=true


# --- NHẬN DIỆN HOÁ ĐƠN BẰNG AI (CLOUDFLARE WORKERS AI / GOOGLE GEMINI) ---
# Bật/tắt AI Vision (true: bật AI | false: vô hiệu hoá AI, chạy 100% Tesseract OCR ngoại tuyến)
OCR_AI_ENABLED=true

# Thời gian chờ AI phản hồi tối đa trước khi tự động chuyển sang Tesseract OCR (khoảng 5-10s, mặc định 8s)
OCR_AI_TIMEOUT=8

# Chọn công cụ nhận diện: 'cloudflare' (Khuyên dùng) | 'gemini' | 'offline' (Tesseract.js không cần mạng)
OCR_ENGINE=cloudflare

# Cloudflare Workers AI (Model Llama 3.2 11B Vision - Miễn phí 10,000 req/ngày)
# Account ID: Lấy từ Dashboard Cloudflare -> Workers & Pages -> Xem cột phải
CLOUDFLARE_ACCOUNT_ID=

# API Token: Lấy từ Dash -> My Profile -> API Tokens -> Create Token (Quyền: Workers AI Read)
CLOUDFLARE_API_TOKEN=

# Google Gemini API Key (Nếu muốn dùng Gemini 1.5 Flash - Lấy tại https://aistudio.google.com)
GEMINI_API_KEY=
