# ==============================================================================
# SỔ THU CHI - CẤU HÌNH MÔI TRƯỜNG & KHÓA ĐỒNG BỘ ĐÁM MÂY
# ==============================================================================
# Hướng dẫn:
# 1. Điền các thông tin của bạn vào các dòng bên dưới.
# 2. File này (.env) đã được tự động thêm vào .gitignore để bảo mật, không bị đẩy lên GitHub.
# 3. Ứng dụng sẽ tự động tải các giá trị này làm mặc định khi khởi chạy!
# ==============================================================================

# --- MÁY CHỦ RIÊNG ĐỒNG BỘ (SELF-HOSTED / DOCKER SYNC SERVER) ---
# Địa chỉ máy chủ riêng của bạn (nếu chạy qua Docker hoặc VPS/Server riêng)
# Ví dụ: http://localhost:8081 hoặc https://sync.domain-cua-ban.com
VITE_SYNC_SERVER_URL=

# Khóa bí mật bảo vệ JWT Session của Server (cho docker-compose hoặc server.js)
JWT_SECRET=sothuchi_super_secure_vault_secret_key_change_me_12345

# --- QUẢN TRỊ VIÊN MÁY CHỦ SAO LƯU (ADMIN DASHBOARD /admin) ---
# Tài khoản và mật khẩu quản trị viên để đăng nhập trang quản trị máy chủ (/admin)
# Dùng để kiểm tra người dùng, dữ liệu rác lúc test hay dữ liệu cũ bị lãng quên
ADMIN_USER=admin
ADMIN_PASSWORD=admin123456

# Danh sách Email Google có quyền Admin truy cập (cách nhau bởi dấu phẩy nếu có)
ADMIN_EMAILS=


# --- GOOGLE DRIVE OAUTH SYNC ---
# Client ID Google lấy từ Google Cloud Console (loại Web Application)
# Ví dụ: 123456789-xxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Nơi lưu trữ trên Google Drive: 'appDataFolder' (Thư mục ẩn an toàn) hoặc 'customFolder' (Thư mục Sổ Thu Chi)
VITE_GOOGLE_STORAGE_LOCATION=appDataFolder

# Tên thư mục nếu chọn customFolder
VITE_GOOGLE_CUSTOM_FOLDER_NAME=Sổ Thu Chi


# --- CLOUDFLARE WORKER TOKEN BRIDGE (Gia hạn ngầm vĩnh viễn cho iPhone / iOS) ---
# Đường dẫn Cloudflare Worker của bạn (ví dụ: https://my-token-bridge.workers.dev)
VITE_GOOGLE_WORKER_URL=

# Client Secret của Google (nếu chưa lưu biến GOOGLE_CLIENT_SECRET trên Cloudflare Worker)
VITE_GOOGLE_CLIENT_SECRET=


# --- DROPBOX PKCE SYNC (Chuẩn hiện đại không cần Server, refresh vĩnh viễn) ---
# App Key của Dropbox lấy từ https://www.dropbox.com/developers/apps
VITE_DROPBOX_APP_KEY=


# --- TỰ ĐỘNG ĐỒNG BỘ ---
# Tự động đồng bộ sau mỗi lần thêm/sửa/xóa giao dịch (true / false)
VITE_AUTO_SYNC_ENABLED=true
